# Public site origin, with no path or trailing slash.
# Required before deployment so the canonical URL, Open Graph image,
# sitemap, and Organization url are absolute. Example: https://example.com
NEXT_PUBLIC_SITE_URL=

# Required before the contact form can deliver a request.
# If this is missing or invalid, the form reports that and does not show success.
#
# This is the public access key shown on the Web3Forms form page.
# There is no secret key for this setup. Web3Forms only accepts this key
# from the browser, so the name must start with NEXT_PUBLIC_.
#
# 1. Open https://web3forms.com
# 2. Enter the inbox that should receive form messages.
#    A personal address such as Gmail works, and so does a business address.
# 3. Copy the access key into the line below.
# The visitor can use a personal or business email. Replies go to that address.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
