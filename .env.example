# Public site origin, with no path or trailing slash.
# Required before deployment so the canonical URL, Open Graph image,
# sitemap, and Organization url are absolute. Example: https://example.com
NEXT_PUBLIC_SITE_URL=

# Required before the contact form can deliver a request.
# If any of these are missing or invalid, the form reports that and does not show success.

# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=

# Sender verified in Resend. Example: TAI Forge <hello@yourdomain.com>
CONTACT_FROM_EMAIL=

# Inbox that should receive health-check and quote requests.
CONTACT_TO_EMAIL=
